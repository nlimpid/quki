// Comment-only edit so Workers Builds deploys this master config. Triggers are unchanged.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quki-crawler",
  "account_id": "a0eb1f96a32491ca1f70971c118831fd",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["30 8 * * 1-5", "0 10 * * 1-5"],
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
}

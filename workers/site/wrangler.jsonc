{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quki",
  "account_id": "a0eb1f96a32491ca1f70971c118831fd",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    { "pattern": "quki.cc", "custom_domain": true },
    { "pattern": "www.quki.cc", "custom_domain": true },
  ],
  "vars": {
    "CLERK_JWT_ISSUER": "https://clerk.quki.cc"
  },
  // Required by `wrangler preview` (Workers Builds on non-production branches).
  // Empty on purpose: assets and compatibility stay above, and this block does
  // not copy production routes, the TiDB URL, or OIDC secrets.
  "previews": {},
}

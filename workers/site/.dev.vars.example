TIDB_QUKI_DATABASE_URL=mysql://user:password@gateway01.region.prod.aws.tidbcloud.com:4000/quki

# Public Clerk Frontend API origin for local `wrangler dev`. Not a secret.
# Leave blank to keep login unavailable.
# Production deploys use the public value in workers/site/wrangler.jsonc.
# A Clerk development instance looks like https://<name>.clerk.accounts.dev
CLERK_JWT_ISSUER=

# Optional local azp allowlist. Unset uses the code default.
# CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173

# Not a Worker variable. Set it in the process that runs `pnpm build:site`.
# Vite inlines it. A runtime setting does not change a build that omitted it.
# Publishable-key placeholder. Do not commit a real key.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "design/**",
    "data/**",
    "db/migrations/**",
    "**/*.html",
    "pnpm-lock.yaml"
  ]
}

{
  "$schema": "https://quki.cc/design/tokens.schema.json",
  "meta": {
    "name": "quki.cc",
    "version": "1.0.0",
    "description": "Design tokens for quki index valuation/timing UI — light & dark"
  },
  "color": {
    "light": {
      "bg": { "canvas": "#F4F6F8", "surface": "#FFFFFF", "surfaceMuted": "#F0F2F5", "elevated": "#FFFFFF", "overlay": "rgba(15, 23, 42, 0.45)" },
      "border": { "default": "#E2E8F0", "muted": "#EEF2F6", "strong": "#CBD5E1", "focus": "#2563EB" },
      "text": { "primary": "#0F172A", "secondary": "#475569", "tertiary": "#94A3B8", "inverse": "#FFFFFF", "link": "#1D4ED8", "disabled": "#CBD5E1" },
      "brand": { "primary": "#1E3A5F", "primaryHover": "#162D4A", "accent": "#2563EB", "accentMuted": "#DBEAFE" },
      "market": { "up": "#DC2626", "upMuted": "#FEE2E2", "down": "#16A34A", "downMuted": "#DCFCE7", "flat": "#64748B" },
      "tier": {
        "t85": { "fill": "rgba(127, 29, 29, 0.18)", "stroke": "#7F1D1D", "label": "#7F1D1D", "solid": "#7F1D1D" },
        "t90": { "fill": "rgba(185, 28, 28, 0.14)", "stroke": "#B91C1C", "label": "#B91C1C", "solid": "#B91C1C" },
        "t95": { "fill": "rgba(234, 88, 12, 0.12)", "stroke": "#EA580C", "label": "#C2410C", "solid": "#EA580C" },
        "t100": { "fill": "rgba(100, 116, 139, 0.10)", "stroke": "#64748B", "label": "#475569", "solid": "#64748B" },
        "t105": { "fill": "rgba(37, 99, 235, 0.08)", "stroke": "#3B82F6", "label": "#1D4ED8", "solid": "#3B82F6" },
        "t110": { "fill": "rgba(14, 165, 233, 0.06)", "stroke": "#0EA5E9", "label": "#0284C7", "solid": "#0EA5E9" }
      },
      "chart": {
        "candleUp": "#DC2626",
        "candleDown": "#16A34A",
        "candleBorderUp": "#B91C1C",
        "candleBorderDown": "#15803D",
        "wickUp": "#DC2626",
        "wickDown": "#16A34A",
        "ma55": "#7C3AED",
        "ma55Width": 1.5,
        "grid": "#E2E8F0",
        "axis": "#94A3B8",
        "crosshair": "#64748B",
        "tooltipBg": "#FFFFFF",
        "tooltipBorder": "#E2E8F0",
        "volumeUp": "rgba(220, 38, 38, 0.35)",
        "volumeDown": "rgba(22, 163, 74, 0.35)",
        "markerConfirmed": "#7F1D1D",
        "markerUnconfirmed": "#F59E0B",
        "markerStroke": "#FFFFFF"
      },
      "state": { "success": "#16A34A", "warning": "#D97706", "danger": "#DC2626", "info": "#2563EB" },
      "badge": {
        "epic": { "bg": "#FEE2E2", "fg": "#7F1D1D", "border": "#FECACA" },
        "important": { "bg": "#FFEDD5", "fg": "#9A3412", "border": "#FED7AA" },
        "unconfirmed": { "bg": "#FEF3C7", "fg": "#92400E", "border": "#FDE68A" },
        "neutral": { "bg": "#F1F5F9", "fg": "#475569", "border": "#E2E8F0" }
      }
    },
    "dark": {
      "bg": { "canvas": "#0B1220", "surface": "#111827", "surfaceMuted": "#0F172A", "elevated": "#1E293B", "overlay": "rgba(0, 0, 0, 0.55)" },
      "border": { "default": "#1F2A3D", "muted": "#172033", "strong": "#334155", "focus": "#60A5FA" },
      "text": { "primary": "#F1F5F9", "secondary": "#94A3B8", "tertiary": "#64748B", "inverse": "#0F172A", "link": "#93C5FD", "disabled": "#475569" },
      "brand": { "primary": "#93C5FD", "primaryHover": "#BFDBFE", "accent": "#60A5FA", "accentMuted": "rgba(37, 99, 235, 0.25)" },
      "market": { "up": "#F87171", "upMuted": "rgba(248, 113, 113, 0.15)", "down": "#4ADE80", "downMuted": "rgba(74, 222, 128, 0.15)", "flat": "#94A3B8" },
      "tier": {
        "t85": { "fill": "rgba(248, 113, 113, 0.22)", "stroke": "#F87171", "label": "#FCA5A5", "solid": "#F87171" },
        "t90": { "fill": "rgba(251, 113, 133, 0.16)", "stroke": "#FB7185", "label": "#FDA4AF", "solid": "#FB7185" },
        "t95": { "fill": "rgba(251, 146, 60, 0.14)", "stroke": "#FB923C", "label": "#FDBA74", "solid": "#FB923C" },
        "t100": { "fill": "rgba(148, 163, 184, 0.12)", "stroke": "#94A3B8", "label": "#CBD5E1", "solid": "#94A3B8" },
        "t105": { "fill": "rgba(96, 165, 250, 0.12)", "stroke": "#60A5FA", "label": "#93C5FD", "solid": "#60A5FA" },
        "t110": { "fill": "rgba(56, 189, 248, 0.10)", "stroke": "#38BDF8", "label": "#7DD3FC", "solid": "#38BDF8" }
      },
      "chart": {
        "candleUp": "#F87171",
        "candleDown": "#4ADE80",
        "candleBorderUp": "#EF4444",
        "candleBorderDown": "#22C55E",
        "wickUp": "#F87171",
        "wickDown": "#4ADE80",
        "ma55": "#C4B5FD",
        "ma55Width": 1.5,
        "grid": "#1F2A3D",
        "axis": "#64748B",
        "crosshair": "#94A3B8",
        "tooltipBg": "#1E293B",
        "tooltipBorder": "#334155",
        "volumeUp": "rgba(248, 113, 113, 0.35)",
        "volumeDown": "rgba(74, 222, 128, 0.35)",
        "markerConfirmed": "#FCA5A5",
        "markerUnconfirmed": "#FBBF24",
        "markerStroke": "#0B1220"
      },
      "state": { "success": "#4ADE80", "warning": "#FBBF24", "danger": "#F87171", "info": "#60A5FA" },
      "badge": {
        "epic": { "bg": "rgba(127, 29, 29, 0.45)", "fg": "#FCA5A5", "border": "rgba(248, 113, 113, 0.35)" },
        "important": { "bg": "rgba(154, 52, 18, 0.40)", "fg": "#FDBA74", "border": "rgba(251, 146, 60, 0.35)" },
        "unconfirmed": { "bg": "rgba(146, 64, 14, 0.40)", "fg": "#FDE68A", "border": "rgba(251, 191, 36, 0.35)" },
        "neutral": { "bg": "rgba(51, 65, 85, 0.50)", "fg": "#CBD5E1", "border": "#334155" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "\"Noto Sans SC\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", system-ui, -apple-system, sans-serif",
      "mono": "\"JetBrains Mono\", \"Noto Sans Mono CJK SC\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace",
      "tabular": "\"JetBrains Mono\", \"Noto Sans Mono CJK SC\", ui-monospace, Menlo, Consolas, monospace"
    },
    "fontSize": {
      "xs": { "size": "11px", "lineHeight": "16px", "letterSpacing": "0.01em" },
      "sm": { "size": "12px", "lineHeight": "18px", "letterSpacing": "0" },
      "md": { "size": "14px", "lineHeight": "22px", "letterSpacing": "0" },
      "lg": { "size": "16px", "lineHeight": "24px", "letterSpacing": "0" },
      "xl": { "size": "18px", "lineHeight": "28px", "letterSpacing": "-0.01em" },
      "2xl": { "size": "22px", "lineHeight": "30px", "letterSpacing": "-0.015em" },
      "3xl": { "size": "28px", "lineHeight": "36px", "letterSpacing": "-0.02em" },
      "display": { "size": "32px", "lineHeight": "40px", "letterSpacing": "-0.025em" }
    },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "pageX": { "desktop": "32px", "tablet": "20px", "mobile": "16px" },
    "pageY": { "desktop": "24px", "tablet": "20px", "mobile": "16px" },
    "sectionGap": { "desktop": "24px", "tablet": "20px", "mobile": "16px" },
    "cardPadding": { "desktop": "20px", "tablet": "16px", "mobile": "14px" }
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(15, 23, 42, 0.05)",
      "md": "0 4px 12px rgba(15, 23, 42, 0.06)",
      "lg": "0 12px 32px rgba(15, 23, 42, 0.08)",
      "focus": "0 0 0 3px rgba(37, 99, 235, 0.25)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.35)",
      "md": "0 4px 12px rgba(0, 0, 0, 0.40)",
      "lg": "0 12px 32px rgba(0, 0, 0, 0.50)",
      "focus": "0 0 0 3px rgba(96, 165, 250, 0.35)"
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 100,
    "dropdown": 200,
    "tooltip": 300,
    "modal": 400,
    "toast": 500
  },
  "breakpoint": {
    "mobileMax": "480px",
    "tabletMin": "481px",
    "tabletMax": "1279px",
    "desktopMin": "1280px",
    "desktopWide": "1440px"
  },
  "layout": {
    "headerHeight": { "desktop": "56px", "mobile": "52px" },
    "toolbarHeight": { "desktop": "48px", "mobile": "44px" },
    "sidebarWidth": "340px",
    "maxContentWidth": "1440px",
    "chartHeight": { "desktop": "480px", "tablet": "400px", "mobile": "280px" },
    "volumeHeight": { "desktop": "80px", "tablet": "64px", "mobile": "48px" }
  },
  "motion": {
    "fast": "120ms",
    "normal": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "formatting": {
    "indexLevel": { "decimals": 2, "example": "4856.32" },
    "percent": { "decimals": 1, "suffix": "%", "example": "92.3%" },
    "date": { "format": "YYYY-MM-DD", "example": "2026-10-31" },
    "datetime": { "format": "YYYY-MM-DD HH:mm", "timezoneLabel": "北京时间" },
    "volume": { "compact": true, "zhUnit": true, "example": "1.23亿" }
  }
}
